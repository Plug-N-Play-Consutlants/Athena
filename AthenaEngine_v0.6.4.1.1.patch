@@ -0,0 +1,81 @@
+"""Regression validator for v0.6.4.1.1 live evidence fallback routing."""
+from __future__ import annotations
+
+from Core.version import ATHENA_VERSION, RELEASE_NAME
+from Scout.conversation.context import ScoutContext
+from Scout.conversation import router
+
+
+def check(name, condition, detail=""):
+    print(f"[{'PASS' if condition else 'FAIL'}] {name}: {detail}")
+    return bool(condition)
+
+
+def _no_matching_leafs_live(*args, **kwargs):
+    return {
+        "version": "test",
+        "question": "Recent Maple Leafs news",
+        "mode": "public",
+        "league": "nhl",
+        "network_enabled": True,
+        "feed_count": 2,
+        "configured_feeds": ["rss_nhl_news", "rss_espn_nhl_news"],
+        "event_count": 1,
+        "selected_count": 0,
+        "events_used": 0,
+        "events": [],
+        "ignored_count": 1,
+        "ignored_events": [
+            {"event_id": "wrong-team", "title": "Canadiens roster update", "reasons": ["entity_mismatch"]},
+        ],
+        "requested_team_terms": ["leafs", "maple", "toronto"],
+        "requested_entity_keys": ["nhl.team.toronto_maple_leafs"],
+        "requested_event_types": [],
+        "status": "configured_no_matching_events",
+        "source_mode": "network",
+        "limitations": ["Live feed acquisition ran, but no configured RSS item matched the requested team/entity."],
+        "evidence_ledger": [],
+    }
+
+
+def main():
+    ok = []
+    original = router.select_live_evidence
+    try:
+        router.select_live_evidence = _no_matching_leafs_live
+        answer = router.route_question("Recent Maple Leafs news", ScoutContext(), mode="public")
+    finally:
+        router.select_live_evidence = original
+
+    natural = str(answer.get("natural_language_response") or "")
+    developer = answer.get("developer") if isinstance(answer.get("developer"), dict) else {}
+    runtime = developer.get("investigation_runtime") if isinstance(developer, dict) else {}
+    selection = runtime.get("evidence_selection") if isinstance(runtime, dict) else {}
+    items = selection.get("items") if isinstance(selection, dict) else []
+
+    ok += [check("version", ATHENA_VERSION == "0.6.4.1.1", ATHENA_VERSION)]
+    ok += [check("release_name", RELEASE_NAME == "Live Evidence Fallback Routing Hotfix", RELEASE_NAME)]
+    ok += [check("route", answer.get("intent") == "live_event_intelligence", str(answer.get("intent")))]
+    ok += [check("news_strategy", runtime.get("strategy") == "news_update", str(runtime.get("strategy")))]
+    ok += [check("concise_strategy", runtime.get("depth") == "concise", str(runtime.get("depth")))]
+    ok += [check("fallback_tier", selection.get("tier") == "recent_fallback", str(selection.get("tier")))]
+    ok += [check(
+        "same_entity_only",
+        bool(items) and all("nhl.team.toronto_maple_leafs" in (item.get("entity_keys") or []) for item in items),
+        str(items),
+    )]
+    ok += [check("no_unrelated_substitution", "Canadiens" not in natural and "Montreal" not in natural, natural)]
+    ok += [check("old_cold_stop_removed", "I do not have a confirmed Maple Leafs event item" not in natural, natural)]
+    ok += [check(
+        "freshness_disclosed",
+        "reliable observation date" in natural.lower() or "most recent evidence observed" in natural.lower(),
+        natural,
+    )]
+    ok += [check("useful_fallback", "Toronto Maple Leafs context" in natural, natural)]
+    ok += [check("discovery_path", "Discovery:" in natural, natural)]
+    print(f"Overall status: {'PASS' if all(ok) else 'FAIL'}")
+    return 0 if all(ok) else 1
+
+
+if __name__ == "__main__":
+    raise SystemExit(main())
